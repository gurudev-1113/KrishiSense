# ==============================================================================
# KrishiSense Environment Configuration (.env.example)
# Copy this file to .env and customize values for your local setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Flask Server Settings
# ------------------------------------------------------------------------------
# Set to 'development' or 'production'
FLASK_ENV=development
FLASK_DEBUG=0

# Secret key for encrypting user sessions and cookies
SECRET_KEY=krishisense_super_secret_key_change_me_in_production

# Host IP and Port:
# '0.0.0.0' allows access from mobile devices on the same Wi-Fi / LAN
HOST=0.0.0.0
PORT=5000

# ------------------------------------------------------------------------------
# 2. Voice Assistant & LLM (Krishi Mitra)
# ------------------------------------------------------------------------------
# Optional: Google Gemini API Key for open-domain agricultural question answering
# If left empty, the voice assistant uses built-in offline NLP rules & responses
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. IoT Hardware & Sensor Telemetry (Module M1)
# ------------------------------------------------------------------------------
# Hardware mode: 'auto' (detect serial/fallback), 'serial' (force USB Arduino), or 'simulate'
KRISHISENSE_HARDWARE_MODE=auto

# Arduino USB Serial Port (e.g., COM6 on Windows, or /dev/ttyUSB0 on Linux)
# Leave blank to auto-detect the connected Arduino Uno
KRISHISENSE_SERIAL_PORT=

# Arduino baud rate (must match firmware: default 9600)
KRISHISENSE_SERIAL_BAUD=9600

# Security token shared between Arduino / telemetry senders and the server
KRISHISENSE_DEVICE_TOKEN=demo-node-token

# Identifier for the physical IoT plant pot node
KRISHISENSE_DEVICE_ID=pot-node-1

# Telemetry ingestion API endpoint
KRISHISENSE_TELEMETRY_URL=http://127.0.0.1:5000/api/telemetry

# Set to 1 to generate synthetic random-walk sensor data when no hardware is plugged in
KRISHISENSE_SIMULATE=0

# ------------------------------------------------------------------------------
# 4. Machine Learning & Training Configuration
# ------------------------------------------------------------------------------
# Number of epochs for retraining the LSTM mandi price prediction model
SMART_DSS_LSTM_EPOCHS=60
